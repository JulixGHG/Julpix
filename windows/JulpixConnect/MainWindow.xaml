<Window x:Class="JulpixConnect.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JulpixConnect — PC Stats Bridge"
        Height="640" Width="920"
        MinHeight="560" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="#0D1117" Foreground="#F0F6FC">

    <Window.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#161B22"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#238636"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#21262D"/>
            <Setter Property="Foreground" Value="#C9D1D9"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="JulpixConnect" FontSize="26" FontWeight="Bold" Foreground="#58A6FF"/>
                <TextBlock Text="Verbinde deinen Windows-PC mit der JulpixStats iPhone-App im Querformat"
                           FontSize="13" Foreground="#8B949E" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="StatusBadge" Background="#1F3A2B" CornerRadius="12" Padding="12,6" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#3FB950" Margin="0,0,8,0"/>
                        <TextBlock x:Name="StatusText" Text="Server aktiv" FontWeight="SemiBold" FontSize="12" Foreground="#3FB950"/>
                    </StackPanel>
                </Border>
                <Button Content="Firewall freigeben" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="OpenFirewall_Click"/>
                <Button Content="In Tray minimieren" Style="{StaticResource SecondaryButton}" Click="MinimizeToTray_Click"/>
            </StackPanel>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column: QR & Pairing -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="PC hinzufügen (QR-Code)" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Text="Scanne diesen Code in JulpixStats auf deinem iPhone." FontSize="12" Foreground="#8B949E" Margin="0,0,0,14"/>

                    <Border Background="White" CornerRadius="12" Padding="12" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <Image x:Name="QrImage" Width="210" Height="210" Stretch="Uniform"/>
                    </Border>

                    <TextBlock Text="PC-Name" FontSize="12" Foreground="#8B949E" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PcNameBox" Background="#0D1117" Foreground="#F0F6FC" BorderBrush="#30363D"
                                 Padding="10,7" FontSize="13" VerticalContentAlignment="Center"/>
                        <Button Grid.Column="2" Content="Speichern" Style="{StaticResource PrimaryButton}" Click="SavePcName_Click"/>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Lokale IP-Adresse" FontSize="11" Foreground="#8B949E"/>
                            <TextBlock x:Name="IpText" Text="—" FontSize="15" FontWeight="SemiBold" Foreground="#58A6FF"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Port" FontSize="11" Foreground="#8B949E"/>
                            <TextBlock x:Name="PortText" Text="52840" FontSize="15" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Pairing-PIN" FontSize="11" Foreground="#8B949E"/>
                            <TextBlock x:Name="PinText" Text="000000" FontSize="22" FontWeight="Bold" Foreground="#F2CC60"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Neuer PIN" Style="{StaticResource SecondaryButton}"
                                VerticalAlignment="Center" Click="RegeneratePin_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Right Column: Live Stats Preview & Connected Devices -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Live Stats Preview -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Live-Telemetrie Vorschau" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <UniformGrid Columns="2" Rows="2">
                            <Border Background="#0D1117" CornerRadius="10" Padding="12" Margin="0,0,8,8">
                                <StackPanel>
                                    <TextBlock Text="CPU" FontSize="11" Foreground="#8B949E"/>
                                    <TextBlock x:Name="CpuPreview" Text="— %" FontSize="20" FontWeight="Bold" Foreground="#58A6FF"/>
                                    <TextBlock x:Name="CpuSubPreview" Text="—" FontSize="11" Foreground="#8B949E" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#0D1117" CornerRadius="10" Padding="12" Margin="8,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="GPU" FontSize="11" Foreground="#8B949E"/>
                                    <TextBlock x:Name="GpuPreview" Text="— %" FontSize="20" FontWeight="Bold" Foreground="#3FB950"/>
                                    <TextBlock x:Name="GpuSubPreview" Text="—" FontSize="11" Foreground="#8B949E" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#0D1117" CornerRadius="10" Padding="12" Margin="0,8,8,0">
                                <StackPanel>
                                    <TextBlock Text="RAM" FontSize="11" Foreground="#8B949E"/>
                                    <TextBlock x:Name="RamPreview" Text="— %" FontSize="20" FontWeight="Bold" Foreground="#D2A8FF"/>
                                    <TextBlock x:Name="RamSubPreview" Text="—" FontSize="11" Foreground="#8B949E"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#0D1117" CornerRadius="10" Padding="12" Margin="8,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="NETZWERK" FontSize="11" Foreground="#8B949E"/>
                                    <TextBlock x:Name="NetPreview" Text="↓ 0  ↑ 0 KB/s" FontSize="16" FontWeight="Bold" Foreground="#F2CC60"/>
                                    <TextBlock x:Name="NetSubPreview" Text="—" FontSize="11" Foreground="#8B949E" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- Connected Devices -->
                <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Verbundene iPhones" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <ListBox x:Name="ClientsList" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="#F0F6FC">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0D1117" CornerRadius="8" Padding="12,8" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold" FontSize="14"/>
                                                <TextBlock Text="{Binding RemoteIp}" FontSize="12" Foreground="#8B949E"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Trennen" Tag="{Binding Id}"
                                                    Style="{StaticResource SecondaryButton}" Click="DisconnectClient_Click"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="NoClientsHint" Grid.Row="1" Text="Noch kein iPhone verbunden. Scanne links den QR-Code in JulpixStats."
                                   Foreground="#8B949E" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
